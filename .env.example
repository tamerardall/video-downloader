# Copy this file to .env and edit it. .env is ignored by git.
# Kopyalayıp .env olarak kaydedin ve düzenleyin. .env git'e eklenmez.

# Address and port to listen on. Keep 127.0.0.1 for local use only.
# For phone access over Tailscale, put your Tailscale IP here (`tailscale ip -4`).
# Never use 0.0.0.0 or expose the port to the internet.
HOST=127.0.0.1
PORT=8000

# Secret key required by every /api/* request as "Authorization: Bearer <key>".
# Required whenever HOST is not 127.0.0.1. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
API_TOKEN=

# Cookies for sites that require login (e.g. Instagram). Use ONE of these.
# Browser name: firefox, chrome, chromium, brave, edge, opera, safari, vivaldi, whale
# For a custom/Flatpak profile use "browser:/path/to/profile", e.g.
#   brave:/home/me/.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser/Default
COOKIES_FROM_BROWSER=
# Or a Netscape-format cookies.txt file exported from your browser.
COOKIES_FILE=

# Comma-separated list of allowed sites (default covers the common ones).
# ALLOWED_DOMAINS=tiktok.com,instagram.com,youtube.com,youtu.be,twitter.com,x.com
